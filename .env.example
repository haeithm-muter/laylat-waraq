# Copy this file to .env and fill in your real values.
# These are read at build time via EXPO_PUBLIC_* (see lib/firebase.ts).
# Never commit the real .env file — it's already in .gitignore.

# Firebase project settings: console.firebase.google.com → Project settings → General → Your apps → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# In the Firebase Console, enable Authentication → Sign-in method for:
# Email/Password, Apple, and Facebook.

# Facebook Login: developers.facebook.com → your app → Settings → Basic → App ID
# Also add this app's redirect URI (laylatwaraq://) as a valid OAuth redirect
# in Facebook Login product settings.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Apple Sign In needs no separate client ID here — it uses this app's iOS
# bundle identifier (com.haithmtalib.laylatwaraq, set in app.json) and the
# "Sign In with Apple" capability, which EAS Build provisions automatically.
# It only works on iOS builds (not Expo Go, not Android).
